<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      保存卡图到相册（P2-4）。API 29+ 走 MediaStore，不需要任何权限；
      26–28 仍然要写外部存储，所以只给老系统声明，避免在新系统上白白多一个权限条目。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      包可见性（Android 11+）：查"这台设备有没有语音识别服务"必须声明，否则
      `queryIntentActivities` / `SpeechRecognizer.isRecognitionAvailable` 一律返回"没有"，
      我们会把一台其实有识别器的机器误判成不支持（2026-11-27 真机排查语音输入时发现）。
      注意 `startActivity` 不受这条限制 —— 它只是让我们能**判断**有没有。
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!--
      usesCleartextTraffic：只是为了能连局域网里的 Ollama / LM Studio（http://192.168.x.x）。
      正式版应该改成只对 debug 生效，或者干脆要求 https。
    -->
    <application
        android:allowBackup="false"
        android:name=".TavernApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidTavern"
        android:usesCleartextTraffic="true">

        <!--
          windowSoftInputMode=adjustResize：配合 Activity 里的 enableEdgeToEdge()，
          键盘弹出时只让 insets 变化（由 Compose 的 imePadding 做动画），
          而不是系统缩放窗口 + Compose 动画同时发生——那会看到画面先抽一下再落回。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              收卡（P2-4）：从文件管理器 / 别的应用「分享」一张卡图或 .charx 进来。
              只接这两类：image/*（PNG 卡）与 application/zip（charx 本质是 zip）。
              文本、链接不接 —— 那会把"分享"变成一个莫名其妙的入口。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
